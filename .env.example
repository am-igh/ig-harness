# Copy to .env if you need to override defaults. Never put API keys here:
# secrets live in the macOS Keychain (see CLAUDE.md).
IG_DATA_DIR=~/IG-Harness-data

# Folders the harness may READ (mounted read-only into the API container).
SUIVI_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Suivi
PROJETS_DIR=/Users/<you>/Tresors/A-Ms_Tresor/Career/ICT4Peace/Admin/ICT4Peace Projets

# Audit checker: only the year folder and the Outils folder (script) are mounted, read-only.
AUDIT_YEAR_DIR=/Users/<you>/Tresors/A-Ms_Tresor/Career/ICT4Peace/Admin/ICT4Peace Audit/2026
AUDIT_TOOLS_DIR=/Users/<you>/Tresors/A-Ms_Tresor/Career/ICT4Peace/Admin/ICT4Peace Audit/Outils

# Scan inbox: where Image Capture saves scans (mounted read-only).
SCAN_INBOX_DIR=/Users/<you>/Scan-Inbox
